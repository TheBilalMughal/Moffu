# ============================================================
# apps/portal — Customer Portal Environment Variables
# ============================================================
# Copy this file to .env.local and fill in values.
# Never commit .env.local or any file containing real secrets.
# ============================================================

# -- Supabase (public/safe to expose in browser) --
# Get from: Supabase dashboard > Project Settings > API
# REQUIRES EXTERNAL SETUP: Supabase project not yet configured
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# -- App --
# TBD: Final production domains
VITE_APP_URL=http://localhost:3001
VITE_WEB_URL=http://localhost:3000

# -- Google OAuth --
# REQUIRES EXTERNAL SETUP: Google Cloud OAuth app not yet configured
# D-003: Google Business Profile V1
# Integration disabled until credentials provided
VITE_GOOGLE_CLIENT_ID=

# -- Paddle Billing --
# Get client token from Paddle dashboard > Developer Tools > Authentication > Client-side tokens
VITE_PADDLE_ENVIRONMENT=sandbox
VITE_PADDLE_CLIENT_TOKEN=

# -- Analytics --
# TBD: PostHog project provisioned; D-010: replay/heatmaps off
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com
