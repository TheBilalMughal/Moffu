# ============================================================
# apps/web — Marketing Site Environment Variables
# ============================================================
# Copy this file to .env.local and fill in values.
# Never commit .env.local or any file containing real secrets.
# ============================================================

# -- App --
# TBD: Final production domain
NEXT_PUBLIC_APP_URL=http://localhost:3000
# TBD: Final customer portal URL
NEXT_PUBLIC_PORTAL_URL=http://localhost:3001

# -- Supabase (public/safe to expose) --
# Get from: Supabase dashboard > Project Settings > API
# REQUIRES EXTERNAL SETUP: Supabase project not yet configured
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -- Analytics --
# TBD: PostHog project provisioned
# D-010: PostHog V1, replay/heatmaps off
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
