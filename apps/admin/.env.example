# ============================================================
# apps/admin — Internal Admin Portal Environment Variables
# ============================================================
# Copy this file to .env.local and fill in values.
# IMPORTANT: Admin portal uses Supabase anon key + platform RBAC.
# Service-role key is NEVER used in the browser.
# ============================================================

# -- Supabase (public/safe to expose in browser) --
# REQUIRES EXTERNAL SETUP: Supabase project not yet configured
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# -- App --
VITE_APP_URL=http://localhost:3002
VITE_PORTAL_URL=http://localhost:3001

# -- Analytics --
# TBD: PostHog project provisioned; D-010: replay/heatmaps off
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com
