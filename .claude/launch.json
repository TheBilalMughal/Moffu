{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@moffu/web", "dev"],
      "port": 3000,
      "url": "http://localhost:3000"
    },
    {
      "name": "portal-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@moffu/portal", "dev", "--port", "3003"],
      "port": 3003,
      "url": "http://localhost:3003"
    },
    {
      "name": "admin-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@moffu/admin", "dev"],
      "port": 3002,
      "url": "http://localhost:3002"
    }
  ]
}
